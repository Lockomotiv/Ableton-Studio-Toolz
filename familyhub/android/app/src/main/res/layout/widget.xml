<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_bg" android:padding="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FamilyHub · Heute" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_lines" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:text="App öffnen, um den Stand zu laden" android:textColor="@color/widget_text"
            android:textSize="15sp" android:lineSpacingExtra="3dp" android:maxLines="5" android:ellipsize="end" />
        <TextView android:id="@+id/w_foot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/widget_muted" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:layout_marginStart="12dp">
        <ImageView android:id="@+id/w_mic" android:layout_width="56dp" android:layout_height="56dp" android:padding="15dp"
            android:background="@drawable/widget_mic_bg" android:src="@drawable/ic_mic" android:contentDescription="Sprechen" />
        <ImageView android:id="@+id/w_add" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:layout_marginTop="10dp"
            android:background="@drawable/widget_add_bg" android:src="@drawable/ic_add" android:contentDescription="Eintragen" />
    </LinearLayout>
</LinearLayout>
