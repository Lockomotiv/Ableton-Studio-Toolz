{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOCK-O-MOTIV Connect Studio",
  "mainBinaryName": "connect-studio",
  "version": "0.3.0",
  "identifier": "de.lockomotiv.connectstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node ../../scripts/prepare-abletonosc.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOCK-O-MOTIV Connect Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws: wss:; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "LOCK-O-MOTIV",
    "category": "Music",
    "shortDescription": "Gemeinsame Musikproduktion mit Ableton Live",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "resources/AbletonOSC/**/*"
    ]
  }
}
